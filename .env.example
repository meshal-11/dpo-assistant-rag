# =====================================================================
# DPO Assistant - Environment Configuration Template
# =====================================================================
# Copy this file to '.env' and insert your actual OpenAI API Key.
# DO NOT commit '.env' to version control or share it publicly.

# OpenAI API Key (Required)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection (Low-cost, high-performance defaults)
# Chat Model: gpt-4o-mini ($0.15/1M input tokens, fast, strong Arabic support)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embedding Model: text-embedding-3-small ($0.02/1M tokens, 1536 dimensions)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Server Configuration
HOST=127.0.0.1
PORT=8000
API_TIMEOUT_SECONDS=30
MAX_QUESTION_LENGTH=500
